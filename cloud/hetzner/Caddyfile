# Caddyfile — reverse proxy con auto-TLS para Louis
#
# Caddy 2 hace ACME (Let's Encrypt) automáticamente. Solo asegúrate que:
#  - LOUIS_DOMAIN y AGENTS_DOMAIN apunten (A record) a la IP del VPS
#  - El puerto 80 esté abierto (lo está por ufw)
#  - El email de contacto es correcto (mostrado en certs y notificaciones LE)

{
    email {$ACME_EMAIL}
    # Logs en JSON van al stderr del container; docker compose logs los captura.
}

# ── Louis (OpenClaw) ────────────────────────────────────────
{$LOUIS_DOMAIN} {
    encode zstd gzip

    # Headers de seguridad básicos
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "no-referrer"
        # Esconde el header Server por default
        -Server
    }

    # Tablero / dashboards protegidos con usuario+contraseña (datos de clientes/legal).
    # TABLERO_USER y TABLERO_HASH vienen del entorno del container (compose → .env).
    # Hash: docker exec louis-caddy caddy hash-password --plaintext 'TU_PASSWORD'
    @tablero path / /dashboard* /agentes* /tablero* /seguimiento* /v1/tablero* /v1/activity*
    basic_auth @tablero {
        {$TABLERO_USER} {$TABLERO_HASH}
    }

    # OpenClaw corre nativo en el host, en localhost:OPENCLAW_PORT
    reverse_proxy 127.0.0.1:{$OPENCLAW_PORT} {
        # WebSocket / SSE — OpenClaw lo usa para streaming de respuestas
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Log de acceso (separa para no mezclar con kawiil)
    log {
        output file /data/logs/louis.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
    }
}

# ── Cerebro Kawiil (MCP Server) ────────────────────────────
{$CEREBRO_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "no-referrer"
        -Server
    }

    # Cerebro Kawiil corre nativo en el host, en localhost:CEREBRO_PORT
    reverse_proxy 127.0.0.1:{$CEREBRO_PORT} {
        # SSE requiere flush inmediato para que el connector de Claude funcione
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /data/logs/cerebro.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
    }
}

# ── kawiil-agents (FastAPI) ─────────────────────────────────
{$AGENTS_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "no-referrer"
        -Server
    }

    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /data/logs/agents.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
    }
}

# ── Biblioteca Legal (SJF + DOF + agentes) ──────────────────
# Acceso del equipo de Kawiil con cuenta Microsoft 365 (oauth2-proxy, ver
# docs/BIBLIOTECA-ACCESO.md). Falla CERRADO: si oauth2-proxy no responde, nadie entra.
# La app (biblioteca.py) escucha solo en 127.0.0.1:BIBLIOTECA_PORT y es de solo lectura.
{$BIBLIOTECA_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        # SAMEORIGIN (no DENY): la ficha de cada tesis incrusta su PDF.
        X-Frame-Options           "SAMEORIGIN"
        Referrer-Policy           "no-referrer"
        Permissions-Policy        "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Endpoints del propio oauth2-proxy (inicio de sesión, callback, cierre de sesión).
    handle /oauth2/* {
        reverse_proxy 127.0.0.1:4180 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Uri {uri}
        }
    }

    # Todo lo demás exige sesión válida; sin ella, redirige al inicio de sesión.
    handle {
        forward_auth 127.0.0.1:4180 {
            uri /oauth2/auth
            header_up X-Real-IP {remote_host}
            copy_headers X-Auth-Request-User X-Auth-Request-Email
            @sin_sesion status 401
            handle_response @sin_sesion {
                redir * /oauth2/start?rd={http.request.uri.path} 302
            }
        }
        reverse_proxy 127.0.0.1:{$BIBLIOTECA_PORT} {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Por aquí solo cuenta la identidad de Microsoft: nunca aceptar la de Tailscale que mande un cliente.
            header_up -Tailscale-User-Login
        }
    }

    log {
        output file /data/logs/biblioteca.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
    }
}
