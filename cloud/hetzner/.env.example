# ============================================================
# Louis en Hetzner — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# El .env NO se sube a git (ver .gitignore).
# ============================================================

# --- Dominios ----------------------------------------------
# El subdominio público para la UI/API de OpenClaw (Louis).
LOUIS_DOMAIN=louis.kawiil.mx

# El subdominio público para el server de kawiil-agents (FastAPI).
AGENTS_DOMAIN=agents.kawiil.mx

# Email de contacto que Caddy usa para Let's Encrypt.
ACME_EMAIL=lbassoco@kawiil.mx

# --- Usuario del sistema -----------------------------------
# Usuario UNIX no-root que correrá los servicios.
SYSTEM_USER=polo

# Llave SSH pública (formato authorized_keys, una sola línea).
# Si la dejas vacía, deploy.sh asume que ya configuraste tu llave en root.
# Ejemplo: ssh-ed25519 AAAA... polo@MacBook-Pro
SYSTEM_USER_SSH_KEY=

# --- Anthropic ---------------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram (canal humano principal) ---------------------
TELEGRAM_BOT_TOKEN=
# tu chat_id personal (numérico, sin comillas)
TELEGRAM_ALLOWED_CHAT_ID=

# --- Slack (Socket Mode) -----------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=

# --- Microsoft 365 / Outlook (dos cuentas separadas, PKCE público) -------
# Memoria nexo_m365_setup + scripts/m365.py: dos apps Entra ID independientes,
# PUBLIC CLIENT con Authorization Code + PKCE (sin client_secret).
# Los tokens vivos (access_token + refresh_token + expiry) viven en
# /opt/openclaw/credentials/m365-{kawiil,yoltik}-tokens.json (un JSON,
# generado en la Mac por oauth-kawiil.py / oauth-yoltik.py, copiado en seed).
# Aquí en .env sólo guardamos los datos estáticos de cada app.

# Cuenta Kawiil (Polo en kawiil.mx)
M365_KAWIIL_TENANT_ID=
M365_KAWIIL_CLIENT_ID=
M365_KAWIIL_REDIRECT_URI=http://localhost:8765/callback

# Cuenta Yoltik (operación yoltik.mx — cumplimiento Ikán)
M365_YOLTIK_TENANT_ID=
M365_YOLTIK_CLIENT_ID=
M365_YOLTIK_REDIRECT_URI=http://localhost:8765/callback

# --- Supabase (kawiil-agents) ------------------------------
SUPABASE_URL=https://qppfampapbxdgednkofc.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- kawiil-agents -----------------------------------------
# Token compartido para que OpenClaw despache tareas async al server.
KAWIIL_DISPATCH_TOKEN=
# Org IDs (los mismos de tu .env local; déjalos vacíos si no aplica)
KAWIIL_ORG_ID=
KAWIIL_KAWIIL_ORG_ID=
KAWIIL_YOLTIK_ORG_ID=

# --- OpenClaw ----------------------------------------------
# Puerto interno (localhost). Caddy hace el TLS público.
OPENCLAW_PORT=3000
# Versión a instalar. `latest` instala la 2026.5.22 actual o más reciente.
OPENCLAW_VERSION=latest

# --- Cerebro Kawiil (MCP Server) ---------------------------
# Subdominio público para el MCP connector de Cowork + Louis.
CEREBRO_DOMAIN=cerebro.kawiil.mx

# Puerto interno (Caddy lo proxea; no abrir en ufw directamente).
CEREBRO_PORT=4040

# Bearer token que Cowork y Louis usan para autenticarse en el MCP.
# Genera uno con: openssl rand -hex 32
CEREBRO_KAWIIL_TOKEN=

# Rutas de datos (por defecto usan las rutas estándar de Louis; solo
# cambia si montaste los datos en otro lugar).
# ENTREGABLES_PATH=/opt/openclaw/entregables
# SJF_DB_PATH=/opt/openclaw/legal/sjf/biblioteca.db
# DOF_DB_PATH=/opt/openclaw/legal/dof/biblioteca_dof.db

# --- Sincronización Mac → Hetzner --------------------------
# Llave SSH pública del Mac (la que va a autorizarse en `polo@hetzner`).
# La generas con: ssh-keygen -t ed25519 -f ~/.ssh/louis_sync -C "louis-sync@mac"
# Y pegas aquí el contenido de ~/.ssh/louis_sync.pub
MAC_SYNC_SSH_PUB_KEY=
