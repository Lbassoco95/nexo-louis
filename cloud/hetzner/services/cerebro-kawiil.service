[Unit]
Description=Cerebro Kawiil MCP Server — cerebro compartido Donna ↔ Cowork
Documentation=https://github.com/Lbassoco95/nexo-louis
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@
EnvironmentFile=@@ENV_FILE@@
ExecStart=/usr/bin/python3 @@OPENCLAW_HOME@@/scripts/cerebro_kawiil_mcp.py
Restart=always
RestartSec=10
StandardOutput=append:@@OPENCLAW_HOME@@/logs/cerebro-kawiil.log
StandardError=append:@@OPENCLAW_HOME@@/logs/cerebro-kawiil.log
SyslogIdentifier=cerebro-kawiil

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=@@OPENCLAW_HOME@@
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
