[Unit]
Description=SJF backfill histórico — rellena el acervo judicial hacia atrás (cada 2h)
Documentation=https://github.com/Lbassoco95/nexo-louis

[Timer]
# 3000 tesis × 24 corridas/día + skip adaptativo para zonas muertas → mucho más rápido.
# Corre cada 1h. El harvest diario (sjf-update) va a las 13:30 UTC; los lotes terminan
# antes de que se solapen (~9 min de duración real).
OnCalendar=*-*-* 00/1:00:00
RandomizedDelaySec=300
# Sin Persistent: tras una caída larga (el servidor estuvo suspendido por
# falta de pago tres semanas), systemd dispararía la corrida perdida EN EL
# ARRANQUE. Corre cada hora; el catch-up solo adelanta una hora y golpea al SJF al arrancar.
# Un arranque no es el momento de salir a la red con todo al mismo tiempo.
Persistent=false

[Install]
WantedBy=timers.target
