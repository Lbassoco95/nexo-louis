[Unit]
Description=Donna — reporte de avance de descargas legales (SJF + DOF) a Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@/legal
# -u: sin esto el stdout va a un archivo en bloques de 4 KB y no se puede seguir
# el progreso en vivo (`tail -f`) mientras el job corre.
ExecStart=/usr/bin/python3 -u @@OPENCLAW_HOME@@/legal/estado_legal.py
StandardOutput=append:@@OPENCLAW_HOME@@/logs/legal-estado.log
StandardError=append:@@OPENCLAW_HOME@@/logs/legal-estado.log
SyslogIdentifier=louis-legal-estado
TimeoutStartSec=300
MemoryMax=256M
