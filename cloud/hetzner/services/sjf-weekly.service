[Unit]
Description=Donna SJF — resumen semanal de tesis del Semanario Judicial (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@/legal/sjf
# -u: sin esto el stdout va a un archivo en bloques de 4 KB y no se puede seguir
# el progreso en vivo (`tail -f`) mientras el job corre.
ExecStart=/usr/bin/python3 -u @@OPENCLAW_HOME@@/legal/sjf/sjf_weekly_summary.py
StandardOutput=append:@@OPENCLAW_HOME@@/logs/sjf-weekly.log
StandardError=append:@@OPENCLAW_HOME@@/logs/sjf-weekly.log
SyslogIdentifier=louis-sjf-weekly
TimeoutStartSec=300
MemoryMax=512M
