[Unit]
Description=Dispara el reporte de avance de descargas legales (lunes y viernes, mañana CDMX)

[Timer]
# Lunes y viernes: cuánto llevamos, si vamos al día con el presente, y cuánto
# del histórico (backfill) llevamos almacenado de SJF y DOF.
OnCalendar=Mon,Fri *-*-* 09:15:00 America/Mexico_City
Persistent=true

[Install]
WantedBy=timers.target
