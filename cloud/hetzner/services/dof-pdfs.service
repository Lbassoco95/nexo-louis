[Unit]
Description=Donna DOF — genera PDF individual por nota (consulta offline + Ollama)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@/legal/dof
Environment=DOF_BASE_DIR=@@OPENCLAW_HOME@@/legal/dof
Environment=DOF_DB_PATH=@@OPENCLAW_HOME@@/legal/dof/biblioteca_dof.db
Environment=DOF_PDF_DIR=@@OPENCLAW_HOME@@/legal/dof/pdfs
ExecStart=/usr/bin/python3 @@OPENCLAW_HOME@@/legal/dof/dof_biblioteca.py generate-pdfs --batch 400
StandardOutput=append:@@OPENCLAW_HOME@@/logs/dof-pdfs.log
StandardError=append:@@OPENCLAW_HOME@@/logs/dof-pdfs.log
SyslogIdentifier=louis-dof-pdfs
TimeoutStartSec=1800
MemoryMax=512M
