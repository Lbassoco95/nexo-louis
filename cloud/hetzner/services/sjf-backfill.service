[Unit]
Description=Donna SJF — backfill histórico del acervo (rellena hacia atrás, ~3000 tesis/run)
Documentation=https://github.com/Lbassoco95/nexo-louis
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@/legal/sjf
Environment=SJF_DB_PATH=@@OPENCLAW_HOME@@/legal/sjf/biblioteca.db
Environment=SJF_HARVEST=@@OPENCLAW_HOME@@/legal/sjf/sjf_harvest.py
Environment=SJF_SCRAPER=@@OPENCLAW_HOME@@/legal/sjf/sjf_biblioteca.py
# Ritmo: 3000 peticiones a 150 ms son ~24,000/hora contra un servicio público de la
# SCJN. El 10-sep su WAF nos bloqueó y el acervo dejó de crecer. A 1500 ms y lotes de
# 1200, una corrida tarda ~30 min y pide ~2,400/hora. El relleno histórico corre solo:
# que tarde semanas en vez de días no le cuesta nada a nadie; estar bloqueados sí.
Environment=BACKFILL_BATCH=1200
Environment=BACKFILL_THROTTLE_MS=1500
Environment=BACKFILL_404_THRESHOLD=50
Environment=BACKFILL_404_JUMP=50000
Environment=SJF_BACKFILL_FLOOR=0
# -u: sin esto el stdout va a un archivo en bloques de 4 KB y no se puede seguir
# el progreso en vivo (`tail -f`) mientras el job corre.
ExecStart=/usr/bin/python3 -u @@OPENCLAW_HOME@@/legal/sjf/sjf_backfill.py
StandardOutput=append:@@OPENCLAW_HOME@@/logs/sjf-backfill.log
StandardError=append:@@OPENCLAW_HOME@@/logs/sjf-backfill.log
SyslogIdentifier=louis-sjf-backfill

NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=@@OPENCLAW_HOME@@
MemoryMax=512M
TasksMax=64
TimeoutStartSec=7200
