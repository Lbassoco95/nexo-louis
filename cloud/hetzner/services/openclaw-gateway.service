[Unit]
Description=OpenClaw Gateway (Donna core HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@
EnvironmentFile=@@ENV_FILE@@
# -u (unbuffered): con StandardOutput=append: el stdout es un archivo normal, y
# Python lo bufferea en bloques de 4 KB. Sin -u el log se atrasa hasta llenar el
# buffer y se PIERDE lo pendiente si el proceso muere de golpe. Antes no se notaba
# porque el código añadía además un logging.FileHandler que escribía al instante
# — pero eso duplicaba cada línea en el archivo. La forma correcta es una sola
# escritura (stdout) y sin buffer.
ExecStart=/usr/bin/python3 -u @@OPENCLAW_HOME@@/scripts/openclaw_gateway.py
Restart=always
RestartSec=5
# Un error de CONFIGURACIÓN (código 78, EX_CONFIG: falta un token) NO se reintenta:
# el servicio queda en 'failed', visible, en vez de reiniciarse para siempre.
# slack-bridge llevaba 268,148 reinicios (~34 días) porque le faltaban los tokens.
RestartPreventExitStatus=78
# Backoff exponencial para crashes REALES (red, API caída): 10s → 20s → … → 5 min,
# en vez de un reintento fijo cada 10s. Sigue auto-sanando, sin martillar el server.
RestartSteps=5
RestartMaxDelaySec=300
StandardOutput=append:@@OPENCLAW_HOME@@/logs/openclaw-gateway.log
StandardError=append:@@OPENCLAW_HOME@@/logs/openclaw-gateway.log
SyslogIdentifier=openclaw-gateway

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=@@OPENCLAW_HOME@@
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
