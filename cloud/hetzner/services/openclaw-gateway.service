[Unit]
Description=OpenClaw Gateway (Louis core HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@
EnvironmentFile=@@ENV_FILE@@
ExecStart=/usr/bin/python3 @@OPENCLAW_HOME@@/scripts/openclaw_gateway.py
Restart=always
RestartSec=5
StandardOutput=append:@@OPENCLAW_HOME@@/logs/openclaw-gateway.log
StandardError=append:@@OPENCLAW_HOME@@/logs/openclaw-gateway.log
SyslogIdentifier=openclaw-gateway

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=@@OPENCLAW_HOME@@
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
