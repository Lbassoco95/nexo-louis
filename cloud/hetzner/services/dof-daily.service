[Unit]
Description=Donna DOF — boletín MATUTINO del Diario Oficial (Telegram, curado por impacto)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@/legal/dof
EnvironmentFile=@@ENV_FILE@@
# -u: sin esto el stdout va a un archivo en bloques de 4 KB y no se puede seguir
# el progreso en vivo (`tail -f`) mientras el job corre.
ExecStart=/usr/bin/python3 -u @@OPENCLAW_HOME@@/legal/dof/dof_daily_summary.py --mat
StandardOutput=append:@@OPENCLAW_HOME@@/logs/dof-daily.log
StandardError=append:@@OPENCLAW_HOME@@/logs/dof-daily.log
SyslogIdentifier=louis-dof-daily
TimeoutStartSec=300
MemoryMax=512M
