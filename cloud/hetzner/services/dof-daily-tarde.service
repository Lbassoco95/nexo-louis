[Unit]
Description=Donna DOF — boletín VESPERTINO del Diario Oficial (Telegram, curado por impacto)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@SYSTEM_USER@@
Group=@@SYSTEM_USER@@
WorkingDirectory=@@OPENCLAW_HOME@@/legal/dof
EnvironmentFile=@@ENV_FILE@@
ExecStart=/usr/bin/python3 @@OPENCLAW_HOME@@/legal/dof/dof_daily_summary.py --ves
StandardOutput=append:@@OPENCLAW_HOME@@/logs/dof-daily.log
StandardError=append:@@OPENCLAW_HOME@@/logs/dof-daily.log
SyslogIdentifier=louis-dof-daily-tarde
TimeoutStartSec=300
MemoryMax=512M
